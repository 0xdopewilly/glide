# ─── Network ────────────────────────────────────────────────────────────────
# "mainnet" or "testnet" (default). One deployment = one network: run mainnet
# as its own Vercel project with its own database and Circle LIVE keys.
NEXT_PUBLIC_GLIDE_NETWORK=testnet

# Circle — server only (never expose to the browser)
# Testnet keys start with TEST_API_KEY:, mainnet keys with LIVE_API_KEY:
CIRCLE_API_KEY=
# Optional Kit Key — format KIT_KEY:keyId:keySecret (NOT TEST_API_KEY).
# App Kit 1.15+ swaps without one; set it only if Circle rejects keyless swaps.
# https://developers.circle.com/w3s/keys#kit-keys
CIRCLE_KIT_KEY=
# Optional alias (same value as CIRCLE_KIT_KEY):
# KIT_KEY=
# STABLECOIN_KIT_API_KEY=
CIRCLE_ENTITY_SECRET=

# Groq — Glide AI assistant (server only)
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web Push (payment alerts) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# CIRCLE_WALLET_SET_ID=
# Required: protects /api/cron/scheduled (Vercel Cron sends it as a Bearer token)
# CRON_SECRET=
# NEXT_PUBLIC_APP_URL=https://app.glidepay.cash

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase Postgres (production) ─────────────────────────────────────────
# Dashboard → Project Settings → Database
#
# DATABASE_URL = "Connection pooling" (Transaction mode, port 6543)
#   postgresql://postgres.[ref]:[PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL = "Direct connection" (port 5432) — used by Prisma migrations only
#   postgresql://postgres.[ref]:[PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:5432/postgres
#
DATABASE_URL=
DIRECT_URL=

# ─── Universal Receive gas service wallets ──────────────────────────────────
# Circle wallet ids holding native gas for sweep top-ups, named after the
# Circle chain id. Provision each via POST /api/admin/gas-wallet, then fund it.
# Testnet:
# GLIDE_GAS_WALLET_BASE_SEPOLIA=
# GLIDE_GAS_WALLET_ETH_SEPOLIA=
# GLIDE_GAS_WALLET_MATIC_AMOY=
# GLIDE_GAS_WALLET_ARB_SEPOLIA=
# Mainnet (real ETH / POL):
# GLIDE_GAS_WALLET_BASE=
# GLIDE_GAS_WALLET_ETH=
# GLIDE_GAS_WALLET_MATIC=
# GLIDE_GAS_WALLET_ARB=
# Clerk user id allowed to call the /api/admin/* gas tools.
# GLIDE_ADMIN_USER_ID=

# ─── Partners ───────────────────────────────────────────────────────────────
# Set to a random secret; partners use /partners/arc?key=THIS_VALUE
PARTNER_ARC_KEY=

# ─── Admin dashboard ────────────────────────────────────────────────────────
# Comma-separated Clerk user ids that can access /admin.
# Anyone not in this list gets a 404 on /admin (via notFound()).
# Find your id in the Clerk dashboard, or log `useUser().user.id` in-app.
# Example: ADMIN_USER_IDS=user_2abc123,user_2def456
ADMIN_USER_IDS=
